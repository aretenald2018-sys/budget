{
  "capture": {
    "schemaVersion": 1,
    "requiredFields": [
      "id",
      "schemaVersion",
      "type",
      "amount",
      "merchant",
      "occurredAt",
      "capturedAt",
      "source"
    ],
    "sources": [
      "android_local_notification",
      "android_local_sms"
    ],
    "queueStatuses": [
      "queued",
      "failed",
      "saved",
      "duplicate",
      "merged"
    ],
    "terminalStatuses": [
      "saved",
      "duplicate",
      "merged"
    ],
    "maxAttempts": 3,
    "retryDelaysMs": [
      30000,
      120000,
      600000
    ]
  },
  "widget": {
    "schemaVersion": 3,
    "fields": [
      "schemaVersion",
      "updatedAt",
      "baselineReady",
      "todaySaved",
      "todaySpend",
      "dailyBaseline",
      "ruleBonusPoints",
      "pointBuckets",
      "points",
      "safeToSpend",
      "funds"
    ],
    "pointBucketFields": [
      "key",
      "label",
      "rate",
      "targetAmount",
      "todayBasePoints",
      "todayBonusPoints",
      "todayPoints",
      "earnedMonthPoints",
      "spentMonthPoints",
      "monthPoints",
      "projectedMonthPoints"
    ],
    "maxPointBuckets": 4,
    "safeToSpendFields": [
      "amount",
      "perDay",
      "daysRemaining",
      "spentRatio",
      "negative",
      "periodLabel",
      "weekDays",
      "weekAmount",
      "ready"
    ],
    "pointsFields": [
      "todayPoints",
      "monthPoints",
      "earnedMonthPoints",
      "spentMonthPoints",
      "projectedMonthPoints"
    ]
  }
}

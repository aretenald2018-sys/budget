<?xml version="1.0" encoding="utf-8"?>
<!--
  위젯 v3 — 히어로는 '이번 2주 써도 되는 돈', 보조는 '적립한 포인트'.
  v2 는 '오늘의 적립' + 4개 고정 포인트 행이었고, safeToSpend 는 스냅샷에만 있고
  렌더되지 않았다. v3 는 결정에 쓰는 금액을 맨 위로 올리고 포인트 행은 2개로 줄인다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reward_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reward_widget_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/reward_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans"
            android:text="써도 되는 돈"
            android:textColor="#f8fafc"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reward_widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:text="대기 중"
            android:textColor="#94a3b8"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/reward_widget_week_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans"
        android:singleLine="true"
        android:text="앱을 열어 갱신"
        android:textColor="#ffffff"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/reward_widget_week_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:singleLine="true"
        android:text="홈 화면 계산 후 표시"
        android:textColor="#cbd5e1"
        android:textSize="10sp" />

    <ProgressBar
        android:id="@+id/reward_widget_week_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:indeterminate="false"
        android:max="100"
        android:maxHeight="24dp"
        android:minHeight="24dp"
        android:progress="0"
        android:progressDrawable="@drawable/reward_widget_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/reward_widget_points_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:singleLine="true"
            android:text="적립 -"
            android:textColor="#f8fafc"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reward_widget_points_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:singleLine="true"
            android:text="-"
            android:textAlignment="viewEnd"
            android:textColor="#94a3b8"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reward_widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/reward_widget_point1_row"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:background="@drawable/reward_widget_row_background">

            <ProgressBar
                android:id="@+id/reward_widget_point1_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="24dp"
                android:minHeight="24dp"
                android:progress="0"
                android:progressDrawable="@drawable/reward_widget_progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/reward_widget_point1_mark"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/reward_widget_mark_background"
                    android:fontFamily="sans"
                    android:gravity="center"
                    android:text="P"
                    android:textColor="#6366f1"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/reward_widget_point1_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans"
                    android:singleLine="true"
                    android:text="포인트 -"
                    android:textColor="#f8fafc"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/reward_widget_point1_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:singleLine="true"
                    android:text="-"
                    android:textAlignment="viewEnd"
                    android:textColor="#f8fafc"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/reward_widget_point2_row"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/reward_widget_row_background">

            <ProgressBar
                android:id="@+id/reward_widget_point2_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="24dp"
                android:minHeight="24dp"
                android:progress="0"
                android:progressDrawable="@drawable/reward_widget_progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/reward_widget_point2_mark"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/reward_widget_mark_background"
                    android:fontFamily="sans"
                    android:gravity="center"
                    android:text="P"
                    android:textColor="#6366f1"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/reward_widget_point2_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans"
                    android:singleLine="true"
                    android:text="포인트 -"
                    android:textColor="#f8fafc"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/reward_widget_point2_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:singleLine="true"
                    android:text="-"
                    android:textAlignment="viewEnd"
                    android:textColor="#f8fafc"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
